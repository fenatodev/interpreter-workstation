[Unit]
Description=Whisper.cpp local STT server for Interpreter
After=graphical-session.target

[Service]
Type=simple
ExecStart=__WHISPER_ROOT__/build-vulkan/bin/whisper-server -m __WHISPER_ROOT__/models/ggml-large-v3-turbo-q5_0.bin -l pt -t 8 --host 127.0.0.1 --port 1264
Restart=always
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=default.target
